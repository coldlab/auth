# Force LF regardless of OS: these files run or are used on Linux (Cloud Build,
# containers, CI), where Windows line endings break them.
*.sh            text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.gcloudignore   text eol=lf
